    "2027": {
        "id": 2027,
        "name": "Imagined Words",
        "begin_time": "2026-08-24 04:00:01",
        "end_time": "2026-09-25 04:00:00",
        "blessings": [
            {
                "id": 3031359,
                "name": "Toccata",
                "description": "Increases Ultimate and Follow-Up ATK DMG dealt by ally targets by 40%. During \"Surging Grit,\" each time an enemy target is inflicted with the \"Dejection\" effect, it changes to stacking 2 stack(s) of this effect instead. The max stacking limit of the \"Dejection\" effect increases to 50 stacks."
            },
            {
                "id": 3031362,
                "name": "Mirthful Cadence",
                "description": "After an ally character uses an Elation Skill to attack an enemy target, inflicts the \"Indulgence\" effect on the attacked enemy target, increasing the DMG taken by this target by 15% for 2 turn(s). This effect applied by each character exists independently. Upon entering \"Surging Grit\", allies gain 40 Punchline(s)."
            },
            {
                "id": 3031360,
                "name": "Fugato",
                "description": "During \"Surging Grit,\" after an ally target uses an attack, additionally causes 1 random DoT debuff currently applied to the attacked target to immediately produce DMG equal to 400% of its original DMG."
            }
        ],
        "fever_buff_info": [
            {
                "name": "Debuff Application",
                "description": "When an ally target inflicts a debuff on an enemy target, allies additionally accumulate 1 Grit Value. This effect can be triggered up to 10 time(s) per enemy target."
            },
            {
                "name": "Concordant Truce",
                "description": "Decreases enemy targets' Effect RES by 30%. Increases DMG taken by enemy targets afflicted with 4 or more debuffs by 20%."
            },
            {
                "name": "Surging Grit",
                "description": "Upon entering \"Surging Grit,\" deals a set amount of DMG to enemy targets 1 time for every debuff they are inflicted with. During \"Surging Grit,\" DMG received by enemy targets increases by 50%. After each time an enemy target is inflicted with a debuff, inflicts 1 stack of \"Dejection\" on them, decreasing their All-Type RES by 1% for 2 turn(s). This effect can stack up to 20 time(s)."
            }
        ],
